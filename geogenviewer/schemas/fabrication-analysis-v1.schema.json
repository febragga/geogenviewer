{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeoGenViewer fabrication analysis 1.0.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "revision": {
      "$ref": "#/$defs/identity"
    },
    "settings": {
      "type": "object",
      "properties": {
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "densityKgM3": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "exclusiveMinimum": 0
              },
              "costPerKg": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "^[A-Z]{3}$"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "name",
              "densityKgM3",
              "costPerKg",
              "currency",
              "source",
              "notes"
            ],
            "additionalProperties": false
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "materialCode": {
                "type": "string",
                "minLength": 1
              },
              "replaces": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "required": [
              "name",
              "materialCode",
              "replaces"
            ],
            "additionalProperties": false
          }
        },
        "activeScenario": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "mapping": {
          "type": "object",
          "properties": {
            "slicer": {
              "type": "string",
              "minLength": 1
            },
            "measured": {
              "type": "string",
              "minLength": 1
            },
            "estimate": {
              "type": "string",
              "minLength": 1
            },
            "machine": {
              "type": "string",
              "minLength": 1
            },
            "production": {
              "type": "string",
              "minLength": 1
            },
            "recorded": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "authored": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "slicer": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              },
              "measured": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              },
              "estimate": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              },
              "machine": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              },
              "production": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              },
              "recorded": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "materials",
        "scenarios",
        "activeScenario",
        "mapping",
        "authored"
      ],
      "additionalProperties": false
    },
    "scope": {
      "enum": [
        "all",
        "visible",
        "selected",
        "filtered",
        "modified",
        "category",
        "material"
      ]
    },
    "grouping": {
      "enum": [
        "category",
        "layer",
        "material",
        "block",
        "part",
        "type",
        "prototype",
        "property",
        "group"
      ]
    },
    "property": {
      "type": "string"
    },
    "scopeValue": {
      "type": "string"
    },
    "report": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "revision",
    "settings",
    "scope",
    "grouping",
    "property",
    "scopeValue"
  ],
  "additionalProperties": false,
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "revisionId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "prototypeId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "geometryKind": {
          "enum": [
            "physicalModel",
            "fullScale",
            "unknown"
          ]
        },
        "scaleDenominator": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sourceOrigin": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "sourceUnit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sourceUpAxis": {
          "enum": [
            "Y",
            "Z",
            null
          ]
        },
        "metersPerSourceUnit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "projectId",
        "revisionId",
        "prototypeId",
        "sha256",
        "geometryKind",
        "scaleDenominator",
        "sourceOrigin",
        "sourceUnit",
        "sourceUpAxis",
        "metersPerSourceUnit"
      ],
      "additionalProperties": false
    }
  }
}
