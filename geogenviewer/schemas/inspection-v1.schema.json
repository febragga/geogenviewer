{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geogenviewer.fernandobragaportfolio.com.br/schemas/inspection-v1.schema.json",
  "title": "GeoGenViewer Inspection 1.0.0",
  "description": "Local viewer inspection data. Geometry and the CAD manifest remain in their original files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "model",
    "sections",
    "measurements",
    "snap",
    "capture"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "model": {
      "$ref": "#/$defs/identity"
    },
    "sections": {
      "$ref": "#/$defs/sections"
    },
    "measurements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "snap": {
      "$ref": "#/$defs/snap"
    },
    "capture": {
      "$ref": "#/$defs/capture"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -1000000000000,
        "maximum": 1000000000000
      }
    },
    "snapMode": {
      "enum": [
        "surface",
        "vertex",
        "edge",
        "midpoint"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "revisionId",
        "sha256",
        "bytes",
        "fileName"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revisionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "plane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "axis",
        "name",
        "enabled",
        "positionM",
        "flipped",
        "gizmo",
        "gizmoOpacity"
      ],
      "properties": {
        "id": {
          "enum": [
            "X",
            "Y",
            "Z"
          ]
        },
        "axis": {
          "enum": [
            "X",
            "Y",
            "Z"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "enabled": {
          "type": "boolean"
        },
        "positionM": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000
        },
        "flipped": {
          "type": "boolean"
        },
        "gizmo": {
          "type": "boolean"
        },
        "gizmoOpacity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planes",
        "mode",
        "fill",
        "fillColor",
        "outlineColor",
        "opacity",
        "lineWidth"
      ],
      "properties": {
        "planes": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/plane"
                },
                {
                  "properties": {
                    "axis": {
                      "const": "X"
                    },
                    "id": {
                      "const": "X"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/plane"
                },
                {
                  "properties": {
                    "axis": {
                      "const": "Y"
                    },
                    "id": {
                      "const": "Y"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/plane"
                },
                {
                  "properties": {
                    "axis": {
                      "const": "Z"
                    },
                    "id": {
                      "const": "Z"
                    }
                  }
                }
              ]
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "mode": {
          "enum": [
            "open",
            "outline",
            "filled",
            "technical"
          ]
        },
        "fill": {
          "type": "boolean"
        },
        "fillColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "outlineColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "opacity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "lineWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shared",
        "views"
      ],
      "properties": {
        "shared": {
          "type": "boolean"
        },
        "views": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "nodePath",
        "localM",
        "instanceId",
        "snap"
      ],
      "properties": {
        "elementId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "nodePath": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "localM": {
          "$ref": "#/$defs/vec3"
        },
        "instanceId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "snap": {
          "$ref": "#/$defs/snapMode"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "pose",
        "valueM",
        "anchors",
        "visible",
        "provenance",
        "capturedIn"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "distance",
            "delta",
            "point"
          ]
        },
        "pose": {
          "enum": [
            "rest",
            "presentation"
          ]
        },
        "valueM": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 4000000000000
            },
            {
              "$ref": "#/$defs/vec3"
            }
          ]
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "visible": {
          "type": "boolean"
        },
        "provenance": {
          "const": "mesh"
        },
        "capturedIn": {
          "enum": [
            "explore",
            "explode",
            "assembly",
            "inspect"
          ]
        }
      }
    },
    "snap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "pixels"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/snapMode"
          },
          "uniqueItems": true
        },
        "pixels": {
          "type": "number",
          "minimum": 4,
          "maximum": 36
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "background",
        "color",
        "measurements",
        "identifiers",
        "gizmos",
        "grid",
        "axes",
        "selection",
        "scale"
      ],
      "properties": {
        "width": {
          "enum": [
            1280,
            1920,
            3840
          ]
        },
        "background": {
          "enum": [
            "transparent",
            "white",
            "custom"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "measurements": {
          "type": "boolean"
        },
        "identifiers": {
          "type": "boolean"
        },
        "gizmos": {
          "type": "boolean"
        },
        "grid": {
          "type": "boolean"
        },
        "axes": {
          "type": "boolean"
        },
        "selection": {
          "type": "boolean"
        },
        "scale": {
          "type": "boolean"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "title",
        "viewName",
        "projection",
        "layout",
        "activeSlot",
        "unit",
        "elementIds",
        "camera"
      ],
      "properties": {
        "generatedAt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 30
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "viewName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "projection": {
          "enum": [
            "perspective",
            "orthographic"
          ]
        },
        "layout": {
          "enum": [
            "single",
            "horizontal",
            "vertical",
            "quad"
          ]
        },
        "activeSlot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "unit": {
          "enum": [
            "m",
            "cm",
            "mm"
          ]
        },
        "elementIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 300,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "target",
            "up",
            "height",
            "projection"
          ],
          "properties": {
            "position": {
              "$ref": "#/$defs/vec3"
            },
            "target": {
              "$ref": "#/$defs/vec3"
            },
            "up": {
              "$ref": "#/$defs/vec3"
            },
            "height": {
              "type": "number",
              "minimum": 1e-12,
              "maximum": 1000000000000
            },
            "projection": {
              "enum": [
                "perspective",
                "orthographic"
              ]
            }
          }
        }
      }
    }
  }
}
